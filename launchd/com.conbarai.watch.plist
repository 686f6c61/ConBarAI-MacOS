<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Plantilla de referencia: install.sh genera la real con rutas absolutas. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.conbarai.watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/TU_USUARIO/.local/bin/conbarai</string>
        <string>watch</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ProcessType</key><string>Background</string>
    <key>LimitLoadToSessionType</key><string>Aqua</string>
    <key>StandardErrorPath</key>
    <string>/Users/TU_USUARIO/.local/state/conbarai/watch.log</string>
</dict>
</plist>
